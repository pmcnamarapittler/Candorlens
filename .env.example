# CandorLens — repo root. Copy to .env and fill in values (.env is gitignored).

# Firecrawl — required for POST /collect-flow
# https://www.firecrawl.dev
FIRECRAWL_API_KEY=
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
# Main-content-only Firecrawl scrape (default: true). Set to false if sites return too little markdown.
# FIRECRAWL_ONLY_MAIN_CONTENT=true

# Report storage — local-first while Azure is not linked.
# When you enable Azure Blob: set REPORT_STORAGE_BACKEND=azure and AZURE_STORAGE_CONNECTION_STRING,
# then restore the Azure functions in backend/services/blob_reports.py (see file comments).
REPORT_STORAGE_BACKEND=local
REPORT_STORAGE_PATH=data/reports
# AZURE_STORAGE_CONNECTION_STRING=

# Fine-tuned BERT (default: ml/models/bert_v1 under this repo)
# MODEL_PATH=
