# CandorLens environment variables
# Copy to .env and fill in real values. .env is gitignored.

# Firecrawl API key — required for POST /collect-flow (URL → events).
# Get one at https://www.firecrawl.dev
FIRECRAWL_API_KEY=fc-your-key-here

# Optional: override the Firecrawl API base URL (defaults to https://api.firecrawl.dev/v2)
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
