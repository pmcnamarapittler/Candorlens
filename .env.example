# CandorLens — repo root. Copy to .env and fill in values (.env is gitignored).

# Firecrawl — required for POST /collect-flow
# https://www.firecrawl.dev
FIRECRAWL_API_KEY=
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2

# Report storage: use local files on your machine, or Azure Blob in production.
REPORT_STORAGE_BACKEND=local
REPORT_STORAGE_PATH=data/reports

# When REPORT_STORAGE_BACKEND=azure — the API creates the "reports" container if missing.
# AZURE_STORAGE_CONNECTION_STRING=

# Fine-tuned BERT directory (default if unset: ml/models/bert_v1 under this repo).
# MODEL_PATH=
