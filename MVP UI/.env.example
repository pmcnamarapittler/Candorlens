# Copy to .env.local for local dev (gitignored by Vite).

# Public FastAPI base URL (no trailing slash). Required for production builds.
# Local default if unset: http://localhost:8000
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: Gemini (AI Studio / in-app features that call Google GenAI)
GEMINI_API_KEY=
